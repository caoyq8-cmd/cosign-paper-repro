import argparse
import json
from collections import Counter
from pathlib import Path

import numpy as np


CENTER = 1502.5
SCALE = 102.5


def speed_to_norm(x):
    return (x - CENTER) / SCALE


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument(
        "--condition_root",
        default="/home/featurize/work/USCT_repro/USCT_download/"
                "condition_cache/inversionnet_oof5_b32_blocks2_e67",
    )
    ap.add_argument(
        "--data_dir",
        default="/home/featurize/work/USCT_repro/"
                "paper_reproduction/cosign_usct/data",
    )
    ap.add_argument(
        "--output",
        default="/home/featurize/work/USCT_repro/"
                "paper_reproduction/cosign_usct/data/c4_pair_manifest.json",
    )
    args = ap.parse_args()

    condition_root = Path(args.condition_root)
    data_dir = Path(args.data_dir)
    out_path = Path(args.output)

    train_files = sorted((condition_root / "train").glob("train_*.npz"))
    if len(train_files) != 897:
        raise RuntimeError(f"Expected 897 train npz files, got {len(train_files)}")

    full_hint_path = data_dir / "full_train_cond_norm.npy"
    full_gt_path = data_dir / "full_train_gt_norm.npy"

    hint_full = np.load(full_hint_path, mmap_mode="r")
    gt_full = np.load(full_gt_path, mmap_mode="r")

    print("full hint shape =", hint_full.shape)
    print("full gt shape   =", gt_full.shape)

    if hint_full.shape != (897, 256, 256):
        raise RuntimeError(f"Unexpected hint shape: {hint_full.shape}")
    if gt_full.shape != (897, 256, 256):
        raise RuntimeError(f"Unexpected gt shape: {gt_full.shape}")

    indices = []
    folds = []

    max_hint_array_diff = 0.0
    max_gt_array_diff = 0.0
    max_hint_norm_formula_diff = 0.0
    max_gt_norm_formula_diff = 0.0

    mse_list = []
    mae_list = []

    for k, p in enumerate(train_files):
        z = np.load(p)

        required = {
            "condition_speed",
            "condition_norm",
            "target_speed",
            "target_norm",
            "sample_index",
            "oof_fold",
        }
        if not required.issubset(set(z.files)):
            raise RuntimeError(f"{p} missing keys: {required - set(z.files)}")

        idx = int(np.asarray(z["sample_index"]).reshape(-1)[0])
        fold = int(np.asarray(z["oof_fold"]).reshape(-1)[0])

        cond_speed = np.asarray(z["condition_speed"], dtype=np.float32)
        cond_norm = np.asarray(z["condition_norm"], dtype=np.float32)

        target_speed = np.asarray(z["target_speed"], dtype=np.float32)
        target_norm = np.asarray(z["target_norm"], dtype=np.float32)

        if cond_norm.shape != (1, 256, 256):
            raise RuntimeError(f"{p}: bad condition_norm shape {cond_norm.shape}")
        if target_norm.shape != (1, 256, 256):
            raise RuntimeError(f"{p}: bad target_norm shape {target_norm.shape}")

        indices.append(idx)
        folds.append(fold)

        # Verify affine normalization.
        hint_formula_diff = float(
            np.max(np.abs(cond_norm - speed_to_norm(cond_speed)))
        )
        gt_formula_diff = float(
            np.max(np.abs(target_norm - speed_to_norm(target_speed)))
        )

        max_hint_norm_formula_diff = max(
            max_hint_norm_formula_diff, hint_formula_diff
        )
        max_gt_norm_formula_diff = max(
            max_gt_norm_formula_diff, gt_formula_diff
        )

        # Verify existing packed arrays are indexed by sample_index.
        hint_diff = float(
            np.max(np.abs(hint_full[idx] - cond_norm[0]))
        )
        gt_diff = float(
            np.max(np.abs(gt_full[idx] - target_norm[0]))
        )

        max_hint_array_diff = max(max_hint_array_diff, hint_diff)
        max_gt_array_diff = max(max_gt_array_diff, gt_diff)

        err = cond_speed.astype(np.float64) - target_speed.astype(np.float64)
        mse_list.append(float(np.mean(err ** 2)))
        mae_list.append(float(np.mean(np.abs(err))))

        if (k + 1) % 100 == 0:
            print(f"checked {k + 1}/{len(train_files)}")

    if len(set(indices)) != 897:
        raise RuntimeError("sample_index is not unique")

    if sorted(indices) != list(range(897)):
        raise RuntimeError(
            f"sample_index is not exactly 0..896: "
            f"min={min(indices)}, max={max(indices)}"
        )

    fold_counts = dict(sorted(Counter(folds).items()))

    audit_path = condition_root / "oof_audit.json"
    with open(audit_path, "r", encoding="utf-8") as f:
        original_audit = json.load(f)

    mse_mean = float(np.mean(mse_list))
    mae_mean = float(np.mean(mae_list))

    print("\n===== RESULT =====")
    print("fold counts =", fold_counts)
    print("baseline MSE =", mse_mean)
    print("baseline MAE =", mae_mean)
    print("max hint packed-array diff =", max_hint_array_diff)
    print("max gt packed-array diff   =", max_gt_array_diff)
    print("max hint norm formula diff =", max_hint_norm_formula_diff)
    print("max gt norm formula diff   =", max_gt_norm_formula_diff)

    # Numerical tolerance only.
    if max_hint_array_diff > 1e-6:
        raise RuntimeError("full_train_cond_norm.npy is misaligned")
    if max_gt_array_diff > 1e-6:
        raise RuntimeError("full_train_gt_norm.npy is misaligned")

    if abs(mse_mean - original_audit["oof_mse_mean"]) > 1e-3:
        raise RuntimeError(
            "Recomputed OOF MSE does not match oof_audit.json"
        )

    if abs(mae_mean - original_audit["oof_mae_mean"]) > 1e-4:
        raise RuntimeError(
            "Recomputed OOF MAE does not match oof_audit.json"
        )

    manifest = {
        "status": "PASS",
        "normalization": {
            "formula": "(speed_mps - 1502.5) / 102.5",
            "center": CENTER,
            "scale": SCALE,
            "nominal_speed_range": [1400.0, 1605.0],
        },
        "train": {
            "n": 897,
            "gt_norm": str(full_gt_path),
            "hint_oof_norm": str(full_hint_path),
            "shape": [897, 256, 256],
            "fold_counts": {str(k): int(v) for k, v in fold_counts.items()},
        },
        "smoke_train": {
            "gt_norm": str(data_dir / "smoke_train_gt_norm.npy"),
            "hint_norm": str(data_dir / "smoke_train_cond_norm.npy"),
            "n": 8,
        },
        "smoke_val": {
            "gt_norm": str(data_dir / "smoke_val_gt_norm.npy"),
            "hint_norm": str(data_dir / "smoke_val_cond_norm.npy"),
            "n": 4,
        },
        "val20": {
            "gt_norm": str(data_dir / "val20_gt_norm.npy"),
            "hint_norm": str(data_dir / "val20_cond_norm.npy"),
            "n": 20,
        },
        "oof_baseline": {
            "mse_mean_speed": mse_mean,
            "mae_mean_speed": mae_mean,
        },
        "alignment": {
            "max_hint_array_diff": max_hint_array_diff,
            "max_gt_array_diff": max_gt_array_diff,
            "max_hint_norm_formula_diff": max_hint_norm_formula_diff,
            "max_gt_norm_formula_diff": max_gt_norm_formula_diff,
        },
        "source_oof_audit": str(audit_path),
    }

    out_path.parent.mkdir(parents=True, exist_ok=True)
    with open(out_path, "w", encoding="utf-8") as f:
        json.dump(manifest, f, indent=2)

    print("\n[PASS] C4 paired-data preparation complete")
    print("manifest =", out_path)


if __name__ == "__main__":
    main()
